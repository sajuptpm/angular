# ------------------------------------------------------------------------------
# Configuration Template: adev-preview-build.yml
# ------------------------------------------------------------------------------
# Copy this file to adev-preview-build.env to set local values or configure
# corresponding GitHub Repository Variables and Secrets via 'gh secret set'
# and 'gh variable set'.
# ------------------------------------------------------------------------------

# Execution Mode Override (Optional)
# Options:
#   auto     - Auto-detect environment: uses 'original' if upstream org or RBE credential present; else 'native'
#   native   - Standard GitHub-hosted execution: local Bazel build and uncompressed artifact upload
#   original - Upstream Google Cloud RBE execution
DEV_INFRA_MODE=auto

# Custom Runner Label (Optional)
# Default: ubuntu-latest
# Set to 'ubuntu-latest-8core' if running on GitHub Enterprise/Team with larger runners,
# or specify a self-hosted runner label.
RUNNER_LABEL=ubuntu-latest

# Parallel Bazel Jobs (Optional)
# Default: 2 for native mode on standard GitHub runners (prevents OOM on 16GB machines).
# Set to 4 or 8 if RUNNER_LABEL has 8 or more cores.
BAZEL_JOBS=2

# Bazel Remote Build Execution Credential (Optional)
# Upstream Google Cloud service account key JSON for RBE trusted builds.
# In 'native' mode or for non-enterprise forks, this secret is NOT required.
RBE_TRUSTED_BUILDS_USER=
