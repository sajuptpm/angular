# ==============================================================================
# Environment Configuration Template for ci.yml (CI push)
# ==============================================================================

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# ------------------------------------------------------------------------------
# Override runner label (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest

# Default execution mode across workflows: "auto", "native", or "original"
DEV_INFRA_MODE=native

# Flag to re-enable automatic CI runs on push in forks (default: false)
ENABLE_CI_PUSH=false

# Repository Secrets (Settings -> Secrets and variables -> Actions -> Secrets)
# ------------------------------------------------------------------------------
# (Optional) Remote Build Execution credentials for Bazel
RBE_TRUSTED_BUILDS_USER=

# (Optional) GitHub PAT for publishing snapshots to external repositories
SNAPSHOT_BUILDS_GITHUB_TOKEN=

# (Optional) Firebase Hosting deployment service account key for adev
ANGULAR_DEV_SITE_DEPLOY=

# (Optional) GitHub token for docs release train metadata inspection
DOCS_DEPLOY_GITHUB_RELEASE_TRAIN_TOKEN=

# (Optional) Algolia API Key for updating synonym records
ALGOLIA_SYNONYM_MANAGER=

# Workflow Dispatch Inputs
# ------------------------------------------------------------------------------
# job: Job to execute ("lint", "devtools", "test", "integration-tests", "adev", "vscode-ng-language-service", "publish-snapshots", "zone-js", "adev-deploy", "all")
INPUT_JOB=lint

# mode: Execution mode ("auto", "native", "original")
INPUT_MODE=native
