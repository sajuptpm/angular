# ------------------------------------------------------------------------------
# Configuration Template: adev-preview-deploy.yml
# ------------------------------------------------------------------------------
# Copy this file to adev-preview-deploy.env to set local values or configure
# corresponding GitHub Repository Variables and Secrets via 'gh secret set'
# and 'gh variable set'.
# ------------------------------------------------------------------------------

# Execution Mode Override (Optional)
# Options:
#   auto     - Auto-detect: uses 'original' if FIREBASE_PREVIEW_SERVICE_TOKEN exists; else 'native'
#   native   - GitHub-native preview extraction, smoke verification, artifact archiving, and step summary
#   original - Deploys to Firebase Hosting via Angular dev-infra action
DEV_INFRA_MODE=auto

# Custom Runner Label (Optional)
# Default: ubuntu-latest
RUNNER_LABEL=ubuntu-latest

# Firebase Preview Deployment Service Token (Optional)
# JSON string or service account token for Firebase project 'ng-dev-previews'.
# Not required for 'native' mode on forks.
FIREBASE_PREVIEW_SERVICE_TOKEN=
