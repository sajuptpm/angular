# ==============================================================================
# Environment Configuration Template for release.yml (Publish Release)
# ==============================================================================

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# ------------------------------------------------------------------------------
# Override runner label (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest

# Default execution mode across workflows: "auto", "native", or "original"
DEV_INFRA_MODE=native

# Repository Secrets (Settings -> Secrets and variables -> Actions -> Secrets)
# ------------------------------------------------------------------------------
# (Optional) Wombot token for NPM publishing upstream
WOMBOT_TOKEN=

# (Optional) Angular Robot GitHub App private key for tagging and release creation
ANGULAR_ROBOT_PRIVATE_KEY=

# Workflow Dispatch Inputs
# ------------------------------------------------------------------------------
# mode: Execution mode ("auto", "native", "original")
INPUT_MODE=native

# dry_run: Dry-run flag ("true", "false")
INPUT_DRY_RUN=true
