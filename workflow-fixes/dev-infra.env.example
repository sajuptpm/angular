# ==============================================================================
# Environment Configuration Template for dev-infra.yml (DevInfra)
# ==============================================================================

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# ------------------------------------------------------------------------------
# Override runner label (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest

# Default execution mode across workflows: "auto", "native", or "original"
DEV_INFRA_MODE=native

# Repository Secrets (Settings -> Secrets and variables -> Actions -> Secrets)
# ------------------------------------------------------------------------------
# (Optional) Private key for Angular Robot GitHub App authentication upstream
ANGULAR_ROBOT_PRIVATE_KEY=

# (Optional) Gemini / Google Generative AI API key for issue auto-labeling
GOOGLE_GENERATIVE_AI_KEY=

# Workflow Dispatch Inputs
# ------------------------------------------------------------------------------
# job: Job to execute ("all", "pull_request_labels", "post_approval_changes", "issue_labels")
INPUT_JOB=pull_request_labels

# mode: Execution mode ("auto", "native", "original")
INPUT_MODE=native

# pr_number: Optional PR number for testing PR labeling and approval verification
INPUT_PR_NUMBER=

# issue_number: Optional issue number for testing issue labeling
INPUT_ISSUE_NUMBER=
