# ------------------------------------------------------------------------------
# Configuration Template: assistant-to-the-branch-manager.yml
# ------------------------------------------------------------------------------
# Copy this file to assistant-to-the-branch-manager.env to set local values or configure
# corresponding GitHub Repository Variables and Secrets via 'gh secret set'
# and 'gh variable set'.
# ------------------------------------------------------------------------------

# Execution Mode Override (Optional)
# Options:
#   auto     - Auto-detect: uses 'original' if ANGULAR_ROBOT_PRIVATE_KEY is set and in upstream org; else 'native'
#   native   - Standard GitHub-native mergeability check via GitHub REST API and status checks
#   original - Dispatches workflow to angular/dev-infra via Angular Robot GitHub App
DEV_INFRA_MODE=auto

# Custom Runner Label (Optional)
# Default: ubuntu-latest
RUNNER_LABEL=ubuntu-latest

# Angular Robot GitHub App Private Key (Optional)
# PEM private key for Angular Robot GitHub App.
# Not required for 'native' mode on forks.
ANGULAR_ROBOT_PRIVATE_KEY=
