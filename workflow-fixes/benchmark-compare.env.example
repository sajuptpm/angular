# ------------------------------------------------------------------------------
# Configuration Template: benchmark-compare.yml
# ------------------------------------------------------------------------------
# Copy this file to benchmark-compare.env to set local values or configure
# corresponding GitHub Repository Variables and Secrets via 'gh secret set'
# and 'gh variable set'.
# ------------------------------------------------------------------------------

# Execution Mode Override (Optional)
# Options:
#   auto     - Auto-detect: uses 'original' if team tokens and upstream org present; else 'native'
#   native   - Standard runner execution with GitHub Step Summary and local Bazel
#   original - Google organization team membership check and Bazel RBE execution
DEV_INFRA_MODE=auto

# Custom Runner Label (Optional)
# Default: ubuntu-latest
RUNNER_LABEL=ubuntu-latest

# Team Membership Verification Token (Optional)
# GitHub token with read:org scope to verify membership in 'angular/team'.
# Not required for 'native' mode on forks.
BENCHMARK_COMPARE_MEMBERSHIP_GITHUB_TOKEN=

# Benchmark Comment Posting Token (Optional)
# GitHub token for posting benchmark results back to pull requests.
# In 'native' mode, automatically falls back to GITHUB_TOKEN.
BENCHMARK_POST_RESULTS_GITHUB_TOKEN=
